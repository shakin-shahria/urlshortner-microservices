FROM golang:1.24-alpine

# Install complete build tools required by CGO/SQLite
RUN apk add --no-cache gcc musl-dev sqlite-dev build-base

WORKDIR /app

# 1. Copy BOTH go.mod and go.sum (if it exists) to leverage Docker caching
COPY go.mod go.sum* ./

# 2. Copy the source code BEFORE running go mod tidy
# This allows go mod tidy to see what packages main.go actually uses
COPY main.go ./

# 3. Download and tidy dependencies with the source code present
RUN go mod download && go mod tidy

# Compile with CGO enabled
ENV CGO_ENABLED=1
RUN go build -tags "libsqlite3" -o urlshortener main.go

# Expose the application port
EXPOSE 8000

# Run the binary
CMD ["./urlshortener"]