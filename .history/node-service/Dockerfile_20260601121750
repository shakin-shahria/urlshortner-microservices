FROM node:24-alpine

# Install tini to handle kernel signals (SIGTERM) properly as PID 1
RUN apk add --no-cache tini

WORKDIR /app

# Copy package lockfiles first for Docker layer caching optimization
# Explicitly ensuring package-lock.json is included for npm ci
COPY package.json package-lock.json* ./

# Use --omit=dev instead of the deprecated --only=production
RUN npm ci --omit=dev

# Copy application source code
COPY server.js ./

# Expose the Node service port
EXPOSE 3000

# Wrap execution with Tini so Kubernetes can gracefully stop/scale the pods
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]