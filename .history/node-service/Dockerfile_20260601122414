FROM node:24-alpine

RUN apk add --no-cache tini

WORKDIR /app

# Explicitly copy both files. If package-lock.json is missing, 
# Docker will fail right here, telling us exactly what's wrong.
COPY package.json package-lock.json ./

RUN npm ci --omit=dev

COPY server.js ./

EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]